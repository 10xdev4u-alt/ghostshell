{
  "name": "ghostshell",
  "version": "0.1.0",
  "description": "A single static HTML file that runs an AI coding agent entirely in your browser. Real Linux VM (v86), local LLM, no server, no account, $0.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/10xdev4u-alt/ghostshell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10xdev4u-alt/ghostshell.git"
  },
  "bugs": {
    "url": "https://github.com/10xdev4u-alt/ghostshell/issues"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "browser",
    "v86",
    "webassembly",
    "local-llm",
    "offline",
    "privacy",
    "single-file"
  ],
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --config vite.singlefile.config.ts",
    "build:verify": "bun run scripts/verify-singlefile.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "bun run scripts/benchmark.ts",
    "image:build": "bash scripts/build-image.sh",
    "release": "bun run build:single && bun run test"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@mlc-ai/web-llm": "^0.2.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.2.4",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "jsdiff": "^1.0.0",
    "v86": "^0.5.473",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.0.0"
  }
}
